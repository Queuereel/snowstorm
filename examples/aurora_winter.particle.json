{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "snowstorm:aurora_winter",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": false,
				"rotation": false,
				"velocity": false
			},
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 7,
				"max_particles": 56
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 12
			},
			"minecraft:emitter_shape_box": {
				"half_dimensions": [9, 0.5, 9],
				"offset": [0, 2.5, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(6, 10)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.sin(variable.particle_age * 0.7 + variable.particle_random_1 * 6.28) * 0.04", 0.02, 0],
				"linear_drag_coefficient": 0.7
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"2 + math.sin(variable.particle_age * 24 + variable.particle_random_2 * 6.28) * 0.5",
					"7 + math.sin(variable.particle_age * 16 + variable.particle_random_1 * 6.28) * 1.5"
				],
				"facing_camera_mode": "rotate_y"
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"0.5 + 0.45 * variable.particle_random_1",
					"0.8 + 0.2 * variable.particle_random_2",
					"1.0",
					"math.sin((variable.particle_age / variable.particle_lifetime) * 3.14159) * 0.65"
				]
			}
		}
	}
}
