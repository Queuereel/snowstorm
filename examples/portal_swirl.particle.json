{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "snowstorm:portal_swirl",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_steady": {
				"spawn_rate": 20,
				"max_particles": 80
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 10
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, 0.5, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 2
			},
			"minecraft:particle_motion_parametric": {
				"relative_position": [
					"math.cos(variable.particle_age * 200 + variable.particle_random_1 * 360) * (1.3 - variable.particle_age * 0.45)",
					"variable.particle_age * 1.5",
					"math.sin(variable.particle_age * 200 + variable.particle_random_1 * 360) * (1.3 - variable.particle_age * 0.45)"
				]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.3, 0.3],
				"facing_camera_mode": "lookat_xyz"
			},
			"minecraft:particle_appearance_tinting": {
				"color": [
					"0.6 + 0.4 * variable.particle_random_2",
					"0.1",
					"0.9",
					"math.sin((variable.particle_age / variable.particle_lifetime) * 3.14159) * 0.8"
				]
			}
		}
	}
}
